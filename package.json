{
  "name": "skewed-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "test:watch": "pnpm -r --filter \"./packages/**\" test:watch",
    "test:browser": "pnpm -r --filter \"./packages/**\" --if-present test:browser",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "storybook": "pnpm --filter @skewed/storybook storybook",
    "storybook:build": "pnpm --filter @skewed/storybook build-storybook",
    "dev:workbench": "pnpm --filter @skewed/workbench dev",
    "release": "node scripts/release.js",
    "publish:release": "node scripts/release.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.22.0",
    "typescript": "^5.6.3"
  }
}
