{
  "name": "@skewed/core",
  "version": "0.0.0",
  "description": "Skewed core engine (SVG 3D scene graph + renderer)",
  "license": "MIT",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/core.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdx build",
    "test": "tsdx test",
    "test:watch": "tsdx test --watch",
    "lint": "tsdx lint",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "tsdx": "^0.14.1",
    "typescript": "^5.6.3"
  }
}


